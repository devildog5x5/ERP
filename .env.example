# Application
APP_NAME=Ledgerly ERP
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./erp.db

# Reminder scheduler (minutes)
REMINDER_INTERVAL_MINUTES=15

# Browser origins allowed to call the API (client runs on :3000)
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Email — leave SMTP_HOST empty to log emails to console (demo mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=erp@yourbusiness.com
SMTP_TLS=true
ALERT_EMAIL_TO=owner@yourbusiness.com
EMAIL_ENABLED=true

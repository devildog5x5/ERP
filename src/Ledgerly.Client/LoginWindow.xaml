<Window x:Class="Ledgerly.Client.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coalesce — Sign in" Height="460" Width="420"
        Icon="pack://application:,,,/Assets/coalesce.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#EEF3F6" FontFamily="Segoe UI">
    <Border Margin="28" Background="White" CornerRadius="14" Padding="28" BorderBrush="#E2E8EE" BorderThickness="1">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="56" Height="56" CornerRadius="12" Background="White" Margin="0,0,14,0"
                        BorderBrush="#E2E8EE" BorderThickness="1" ClipToBounds="True">
                    <Image Source="pack://application:,,,/Assets/coalesce-icon.png" Stretch="Uniform"
                           Margin="4" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Coalesce" FontSize="22" FontWeight="SemiBold" Foreground="#15202B"/>
                    <TextBlock Text="Where ERP and CRM come together" Foreground="#667888" FontSize="12" Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="Username" Foreground="#667888" Margin="0,0,0,4"/>
            <TextBox x:Name="UserBox" Text="admin" Padding="10,8" Margin="0,0,0,12"/>
            <TextBlock Text="Password" Foreground="#667888" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PassBox" Padding="10,8" Margin="0,0,0,8"/>
            <TextBlock Text="Default: admin / admin" Foreground="#9AA8B4" FontSize="11" Margin="0,0,0,16"/>
            <Button x:Name="LoginBtn" Content="Sign in" Style="{StaticResource PrimaryButton}" Click="Login_Click" IsDefault="True" Height="40"/>
            <TextBlock x:Name="ErrorText" Foreground="#B42318" TextWrapping="Wrap" Margin="0,14,0,0"/>
        </StackPanel>
    </Border>
</Window>

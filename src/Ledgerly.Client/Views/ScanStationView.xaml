<UserControl x:Class="Ledgerly.Client.Views.ScanStationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F8F8" BorderBrush="#D7E4E3" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="USB barcode scanners work as keyboards — click the box, then scan." Foreground="#667888" Margin="0,0,0,10"/>
                <TextBox x:Name="ScanBox" FontSize="22" Padding="14,12" FontFamily="Consolas"
                         KeyDown="ScanBox_KeyDown"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <RadioButton x:Name="ModeLookup" Content="Lookup" IsChecked="True" Margin="0,0,16,0" GroupName="ScanMode"/>
                    <RadioButton x:Name="ModeAdjustIn" Content="Stock +1" Margin="0,0,16,0" GroupName="ScanMode"/>
                    <RadioButton x:Name="ModeAdjustOut" Content="Stock −1" Margin="0,0,16,0" GroupName="ScanMode"/>
                    <RadioButton x:Name="ModeReceive" Content="Receive PO" Margin="0,0,16,0" GroupName="ScanMode"/>
                    <RadioButton x:Name="ModeSale" Content="Quick sale" GroupName="ScanMode"/>
                </StackPanel>
                <DockPanel Margin="0,12,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="PO for receive:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#667888"/>
                    <ComboBox x:Name="PoCombo" DisplayMemberPath="Label" MinWidth="280" Padding="6"/>
                </DockPanel>
                <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="Customer for sale:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#667888"/>
                    <ComboBox x:Name="CustomerCombo" DisplayMemberPath="Name" SelectedValuePath="Id" MinWidth="280" Padding="6"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" x:Name="ResultPanel" BorderBrush="#E2E8EE" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ResultTitle" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="ResultDetail" Foreground="#667888" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Quick sale cart" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Checkout" Style="{StaticResource PrimaryButton}" Click="Checkout_Click" Margin="0,0,8,0"/>
                        <Button Content="Clear" Style="{StaticResource SecondaryButton}" Click="ClearCart_Click"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" x:Name="CartTotals" Margin="0,8,0,0" FontWeight="SemiBold"/>
                <DataGrid x:Name="CartGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderThickness="0" CanUserAddRows="False" RowHeight="34">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100"/>
                        <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=C}" Width="80"/>
                        <DataGridTextColumn Header="Line" Binding="{Binding LineTotal, StringFormat=C}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Recent stock movements" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DataGrid x:Name="MovementGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderThickness="0" CanUserAddRows="False" RowHeight="34">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When" Binding="{Binding CreatedAt, StringFormat=g}" Width="130"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding ProductSku}" Width="90"/>
                        <DataGridTextColumn Header="Δ" Binding="{Binding QuantityDelta}" Width="50"/>
                        <DataGridTextColumn Header="After" Binding="{Binding QuantityAfter}" Width="60"/>
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>

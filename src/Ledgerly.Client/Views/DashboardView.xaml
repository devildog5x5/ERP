<UserControl x:Class="Ledgerly.Client.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Margin="0,0,10,0" Padding="16" BorderBrush="#E2E8EE" BorderThickness="1" CornerRadius="12" Background="White">
                    <StackPanel>
                        <TextBlock Text="PRODUCTS" Foreground="#667888" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="KpiProducts" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Margin="0,0,10,0" Padding="16" BorderBrush="#F3C4BF" BorderThickness="1" CornerRadius="12" Background="#FEF3F2">
                    <StackPanel>
                        <TextBlock Text="LOW STOCK" Foreground="#667888" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="KpiLow" Text="—" FontSize="28" FontWeight="SemiBold" Foreground="#B42318" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Margin="0,0,10,0" Padding="16" BorderBrush="#E2E8EE" BorderThickness="1" CornerRadius="12" Background="White">
                    <StackPanel>
                        <TextBlock Text="OPEN POs" Foreground="#667888" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="KpiPos" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Padding="16" BorderBrush="#E2E8EE" BorderThickness="1" CornerRadius="12" Background="White">
                    <StackPanel>
                        <TextBlock Text="INVENTORY VALUE" Foreground="#667888" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="KpiValue" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="Low stock / buy now" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <DataGrid x:Name="LowStockGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" CanUserAddRows="False" RowHeight="36">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120"/>
                            <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="On hand" Binding="{Binding QuantityOnHand}" Width="80"/>
                            <DataGridTextColumn Header="Reorder" Binding="{Binding ReorderPoint}" Width="80"/>
                            <DataGridTextColumn Header="Buy qty" Binding="{Binding ReorderQuantity}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="Active reminders" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ListBox x:Name="ReminderList" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E2E8EE" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Severity}" FontSize="11" Foreground="#9A5B12" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#667888" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

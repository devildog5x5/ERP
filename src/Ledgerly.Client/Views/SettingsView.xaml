<UserControl x:Class="Ledgerly.Client.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Ledgerly.Client.Services">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Company" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
            <TextBlock Text="Company name" Foreground="#667888" Margin="0,0,0,4"/>
            <TextBox x:Name="CompanyNameBox" Padding="8,6" Margin="0,0,0,12"/>
            <TextBlock Text="Default sales tax rate (%)" Foreground="#667888" Margin="0,0,0,4"/>
            <TextBox x:Name="TaxRateBox" Padding="8,6" Margin="0,0,0,12"/>
            <TextBlock Text="Currency" Foreground="#667888" Margin="0,0,0,4"/>
            <TextBox x:Name="CurrencyBox" Padding="8,6" Margin="0,0,0,12"/>
            <TextBlock Text="Receipt footer" Foreground="#667888" Margin="0,0,0,4"/>
            <TextBox x:Name="FooterBox" Padding="8,6" AcceptsReturn="True" Height="72" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock Text="PO approval threshold" Foreground="#667888" Margin="0,0,0,4"/>
            <TextBox x:Name="ApprovalBox" Padding="8,6" Margin="0,0,0,12"/>
            <TextBlock Text="SMTP host (email invoices)" Foreground="#667888" Margin="0,0,0,4"/>
            <TextBox x:Name="SmtpHostBox" Padding="8,6" Margin="0,0,0,12"/>
            <TextBlock Text="SMTP from address" Foreground="#667888" Margin="0,0,0,4"/>
            <TextBox x:Name="SmtpFromBox" Padding="8,6" Margin="0,0,0,16"/>

            <TextBlock Text="Client connection" FontWeight="SemiBold" FontSize="16" Margin="0,8,0,10"/>
            <TextBlock Text="API base URL" Foreground="#667888" Margin="0,0,0,4"/>
            <TextBox x:Name="ApiUrlBox" Padding="8,6" Margin="0,0,0,16"/>

            <TextBlock Text="Database platform" FontWeight="SemiBold" FontSize="16" Margin="0,8,0,10"/>
            <TextBlock x:Name="DbPlatformText" TextWrapping="Wrap" Foreground="#2A3A48" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Foreground="#667888" Margin="0,0,0,12"
                       Text="Default is local SQLite. When you need more capacity or multi-user access, use Grow database… (Administrator) to move to SQL Server, MySQL, or PostgreSQL — no command line required."/>

            <Border x:Name="AdminDbStatusPanel" Visibility="Collapsed" Margin="0,0,0,16"
                    BorderBrush="#D0E4F5" BorderThickness="1" Background="#F5FAFE" CornerRadius="10" Padding="14">
                <StackPanel>
                    <TextBlock Text="Administrator — database health" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ContentControl x:Name="DbStatusPieHost" Width="88" Height="88" Margin="0,0,14,0"
                                        VerticalAlignment="Top"/>
                        <TextBlock x:Name="DbStatusSummaryText" TextWrapping="Wrap" Foreground="#2A3A48"
                                   VerticalAlignment="Center" MaxWidth="400"
                                   Text="Loading database status…"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Grow database…" Style="{StaticResource PrimaryButton}"
                                Click="GrowDatabase_Click" Margin="0,0,8,0"/>
                        <Button Content="Database status…" Style="{StaticResource SecondaryButton}"
                                Click="DatabaseStatus_Click" Margin="0,0,8,0"/>
                        <Button Content="Refresh status" Style="{StaticResource SecondaryButton}"
                                Click="RefreshDbStatus_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0,0,8,0" svc:Access.Permission="settings"/>
                <Button Content="Test connection" Style="{StaticResource SecondaryButton}" Click="Test_Click" Margin="0,0,8,0"/>
                <Button Content="Refresh platform info" Style="{StaticResource SecondaryButton}" Click="RefreshPlatform_Click"/>
            </StackPanel>

            <Border x:Name="AdminDangerPanel" Visibility="Collapsed" Margin="0,28,0,0"
                    BorderBrush="#FECACA" BorderThickness="1" Background="#FEF2F2" CornerRadius="10" Padding="16">
                <StackPanel>
                    <TextBlock Text="Danger zone" FontWeight="SemiBold" FontSize="16" Foreground="#B42318" Margin="0,0,0,8"/>

                    <!-- Visible guide entry point next to refresh / wipe controls -->
                    <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1"
                            CornerRadius="8" Padding="10,8" Margin="0,0,0,14">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="DatabaseGuideInfoBtn" DockPanel.Dock="Left"
                                    Width="28" Height="28" Margin="0,0,10,0"
                                    VerticalAlignment="Center" Cursor="Hand"
                                    Click="DatabaseGuide_Click"
                                    ToolTip="Open full instructions: grow, status, backup, purge, and refresh database.">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse x:Name="bg" Width="28" Height="28" Fill="#1D4ED8"/>
                                            <TextBlock Text="i" Foreground="White" FontWeight="Bold" FontSize="14"
                                                       FontFamily="Georgia, Times New Roman, serif"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,-1,0,0"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Fill" Value="#1E40AF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Foreground="#9A3412" TextWrapping="Wrap"
                                           Text="Database guide — grow, backup, purge &amp; refresh"/>
                                <TextBlock Foreground="#9A3412" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="Tap the (i) for the full step-by-step process before you change or wipe the database."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock TextWrapping="Wrap" Foreground="#667888" Margin="0,0,0,12"
                               Text="Refresh database wipes all business data, recreates the schema, and reseeds clean system defaults only (roles, admin user, tax codes, GL accounts, locations — no demo customers, suppliers, products, or orders). A backup is taken first. Administrator only. You must complete three confirmations before it runs. You will need to sign in again (admin / admin)."/>
                    <Button x:Name="RefreshDatabaseBtn" Content="Refresh database…" Style="{StaticResource DangerButton}"
                            HorizontalAlignment="Left" Click="RefreshDatabase_Click"/>
                    <StackPanel x:Name="RefreshProgressPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <TextBlock x:Name="RefreshProgressText" Text="Preparing…" Foreground="#2A3A48" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="RefreshProgressBar" Height="18" Minimum="0" Maximum="100" Value="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Margin="0,14,0,0" Foreground="#667888" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>

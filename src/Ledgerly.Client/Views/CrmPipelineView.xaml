<UserControl x:Class="Ledgerly.Client.Views.CrmPipelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Ledgerly.Client.Services">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Add opportunity" Style="{StaticResource PrimaryButton}" Click="Add_Click" Margin="0,0,8,0" svc:Access.Permission="crm"/>
            <Button Content="Edit" Style="{StaticResource SecondaryButton}" Click="Edit_Click" Margin="0,0,8,0" svc:Access.Permission="crm"/>
            <Button Content="Mark won → sales quote" Style="{StaticResource SecondaryButton}" Click="Win_Click" Margin="0,0,8,0" svc:Access.Permission="crm"/>
            <Button Content="Delete" Style="{StaticResource DangerButton}" Click="Delete_Click" svc:Access.Permission="crm"/>
        </StackPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  BorderThickness="0" CanUserAddRows="False" RowHeight="38" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Opportunity" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="160"/>
                <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="120"/>
                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C}" Width="100"/>
                <DataGridTextColumn Header="Expected close" Binding="{Binding ExpectedClose, StringFormat=d}" Width="120"/>
                <DataGridTextColumn Header="Sales order #" Binding="{Binding SalesOrderId}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

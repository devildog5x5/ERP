<UserControl x:Class="Ledgerly.Client.Views.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="420" HorizontalAlignment="Left">
            <TextBlock Text="Change your password" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Foreground="#667888" Margin="0,0,0,16"
                       Text="Update the password for your signed-in account. You will stay signed in after a successful change."/>

            <TextBlock Text="Current password" Foreground="#667888" Margin="0,0,0,4"/>
            <PasswordBox x:Name="CurrentBox" Padding="10,8" Margin="0,0,0,12"/>

            <TextBlock Text="New password" Foreground="#667888" Margin="0,0,0,4"/>
            <PasswordBox x:Name="NewBox" Padding="10,8" Margin="0,0,0,12"/>

            <TextBlock Text="Confirm new password" Foreground="#667888" Margin="0,0,0,4"/>
            <PasswordBox x:Name="ConfirmBox" Padding="10,8" Margin="0,0,0,16"/>

            <Button Content="Update password" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Left" Height="36" MinWidth="140" Click="Save_Click"/>
            <TextBlock x:Name="StatusText" Margin="0,14,0,0" Foreground="#667888" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="Ledgerly.Client.Views.SalesOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Ledgerly.Client.Services">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Add" Style="{StaticResource PrimaryButton}" Click="Add_Click" Margin="0,0,8,0" svc:Access.Permission="sales"/>
            <Button Content="Edit" Style="{StaticResource SecondaryButton}" Click="Edit_Click" Margin="0,0,8,0" svc:Access.Permission="sales"/>
            <Button Content="Print" Style="{StaticResource SecondaryButton}" Click="Print_Click" Margin="0,0,8,0" svc:Access.Permission="print"/>
            <Button Content="Convert quote" Style="{StaticResource SecondaryButton}" Click="Convert_Click" Margin="0,0,8,0" svc:Access.Permission="sales"/>
            <Button Content="Take payment" Style="{StaticResource SecondaryButton}" Click="Pay_Click" Margin="0,0,8,0" svc:Access.Permission="sales"/>
            <Button Content="RMA return" Style="{StaticResource SecondaryButton}" Click="Return_Click" Margin="0,0,8,0" svc:Access.Permission="sales"/>
            <Button Content="Export CSV" Style="{StaticResource SecondaryButton}" Click="Export_Click" Margin="0,0,8,0" svc:Access.Permission="sales"/>
            <Button Content="Delete" Style="{StaticResource DangerButton}" Click="Delete_Click" svc:Access.Permission="sales"/>
        </StackPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  BorderThickness="0" CanUserAddRows="False" RowHeight="38"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Order" Binding="{Binding OrderNumber}" Width="140"/>
                <DataGridTextColumn Header="Type" Binding="{Binding DocumentType}" Width="80"/>
                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Date" Binding="{Binding OrderDate, StringFormat=d}" Width="100"/>
                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C}" Width="100"/>
                <DataGridTextColumn Header="Tax" Binding="{Binding TaxAmount, StringFormat=C}" Width="90"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

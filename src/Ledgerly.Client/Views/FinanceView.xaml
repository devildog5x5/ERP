<UserControl x:Class="Ledgerly.Client.Views.FinanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Ledgerly.Client.Services">
    <TabControl BorderThickness="0">
        <TabItem Header="GL accounts">
            <DataGrid x:Name="GlGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0"
                      HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="No." Binding="{Binding AccountNumber}" Width="80"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding AccountType}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </TabItem>
        <TabItem Header="Journals">
            <DataGrid x:Name="JeGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0"
                      HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Entry" Binding="{Binding EntryNumber}" Width="120"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding EntryDate}" Width="100"/>
                    <DataGridTextColumn Header="Memo" Binding="{Binding Memo}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </TabItem>
        <TabItem Header="Bank">
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Top" Content="Reconcile selected" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" Margin="0,0,0,8" Click="Reconcile_Click" svc:Access.Permission="finance"/>
                <DataGrid x:Name="BankGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding TxnDate}" Width="100"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C}" Width="100"/>
                        <DataGridCheckBoxColumn Header="Reconciled" Binding="{Binding IsReconciled}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
        <TabItem Header="Periods / FX / Co.">
            <StackPanel Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Close selected period" Style="{StaticResource DangerButton}" Click="ClosePeriod_Click" svc:Access.Permission="finance"/>
                </StackPanel>
                <DataGrid x:Name="PeriodGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="120"
                          HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False" Margin="0,0,0,12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Period" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Start" Binding="{Binding StartDate}" Width="100"/>
                        <DataGridTextColumn Header="End" Binding="{Binding EndDate}" Width="100"/>
                        <DataGridCheckBoxColumn Header="Closed" Binding="{Binding IsClosed}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid x:Name="FxGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="100"
                          HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False" Margin="0,0,0,12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Currency" Binding="{Binding CurrencyCode}" Width="100"/>
                        <DataGridTextColumn Header="Rate to base" Binding="{Binding RateToBase}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid x:Name="CoGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="80"
                          HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80"/>
                        <DataGridTextColumn Header="Company" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Base FX" Binding="{Binding BaseCurrency}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </TabItem>
    </TabControl>
</UserControl>

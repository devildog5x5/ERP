<UserControl x:Class="Ledgerly.Client.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Ledgerly.Client.Services">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Add" Style="{StaticResource PrimaryButton}" Click="Add_Click" Margin="0,0,8,0" svc:Access.Permission="inventory"/>
                <Button Content="Edit" Style="{StaticResource SecondaryButton}" Click="Edit_Click" Margin="0,0,8,0" svc:Access.Permission="inventory"/>
                <Button Content="Delete" Style="{StaticResource DangerButton}" Click="Delete_Click" Margin="0,0,8,0" svc:Access.Permission="inventory"/>
                <Button Content="Adjust qty" Style="{StaticResource SecondaryButton}" Click="Adjust_Click" Margin="0,0,8,0" svc:Access.Permission="inventory"/>
                <Button Content="Export CSV" Style="{StaticResource SecondaryButton}" Click="Export_Click" Margin="0,0,16,0" svc:Access.Permission="inventory"/>
                <Button Content="Show low stock" Style="{StaticResource SecondaryButton}" Click="ToggleLow_Click" x:Name="ToggleLowBtn" svc:Access.Permission="inventory"/>
            </StackPanel>
            <DockPanel>
                <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#667888"/>
                <TextBox x:Name="SearchBox" Padding="8,6" KeyDown="SearchBox_KeyDown"/>
            </DockPanel>
        </StackPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  BorderThickness="0" CanUserAddRows="False" RowHeight="38"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120"/>
                <DataGridTextColumn Header="UPC" Binding="{Binding Upc}" Width="130"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
                <DataGridTextColumn Header="On hand" Binding="{Binding QuantityOnHand}" Width="90"/>
                <DataGridTextColumn Header="Reorder" Binding="{Binding ReorderPoint}" Width="90"/>
                <DataGridTextColumn Header="Buy qty" Binding="{Binding ReorderQuantity}" Width="90"/>
                <DataGridTextColumn Header="Cost" Binding="{Binding UnitCost, StringFormat=C}" Width="90"/>
                <DataGridTextColumn Header="Price" Binding="{Binding SellPrice, StringFormat=C}" Width="90"/>
                <DataGridCheckBoxColumn Header="Reorder?" Binding="{Binding NeedsReorder}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

<UserControl x:Class="Ledgerly.Client.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Padding="14" Margin="0,0,8,0" BorderBrush="#E2E8EE" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="INVENTORY VALUE" FontSize="11" Foreground="#667888" FontWeight="Bold"/>
                        <TextBlock x:Name="InvValue" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Padding="14" Margin="0,0,8,0" BorderBrush="#E2E8EE" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="GROSS MARGIN % (MTD)" FontSize="11" Foreground="#667888" FontWeight="Bold"/>
                        <TextBlock x:Name="MarginPct" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Padding="14" Margin="0,0,8,0" BorderBrush="#E2E8EE" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="AR TOTAL" FontSize="11" Foreground="#667888" FontWeight="Bold"/>
                        <TextBlock x:Name="ArTotal" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Padding="14" BorderBrush="#E2E8EE" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="AP TOTAL" FontSize="11" Foreground="#667888" FontWeight="Bold"/>
                        <TextBlock x:Name="ApTotal" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <TextBlock Text="AR aging" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <DataGrid x:Name="ArGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="160" Margin="0,0,0,16"
                      HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Customer" Binding="{Binding PartnerName}" Width="*"/>
                    <DataGridTextColumn Header="Current" Binding="{Binding Current, StringFormat=C}" Width="90"/>
                    <DataGridTextColumn Header="31-60" Binding="{Binding Days30, StringFormat=C}" Width="90"/>
                    <DataGridTextColumn Header="61-90" Binding="{Binding Days60, StringFormat=C}" Width="90"/>
                    <DataGridTextColumn Header="90+" Binding="{Binding Days90Plus, StringFormat=C}" Width="90"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="AP aging" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <DataGrid x:Name="ApGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="140" Margin="0,0,0,16"
                      HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Supplier" Binding="{Binding PartnerName}" Width="*"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Dead / slow stock" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <DataGrid x:Name="DeadGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="140"
                      HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="On hand" Binding="{Binding QuantityOnHand}" Width="90"/>
                    <DataGridTextColumn Header="Margin %" Binding="{Binding MarginPercent}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

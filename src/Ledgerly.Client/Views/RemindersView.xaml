<UserControl x:Class="Ledgerly.Client.Views.RemindersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Ledgerly.Client.Services">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Add" Style="{StaticResource PrimaryButton}" Click="Add_Click" Margin="0,0,8,0" svc:Access.Permission="reminders"/>
            <Button Content="Edit" Style="{StaticResource SecondaryButton}" Click="Edit_Click" Margin="0,0,8,0" svc:Access.Permission="reminders"/>
            <Button Content="Delete" Style="{StaticResource DangerButton}" Click="Delete_Click" svc:Access.Permission="reminders"/>
        </StackPanel>
        <ListBox x:Name="List" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#E2E8EE" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Resolve" Style="{StaticResource SecondaryButton}"
                                    Tag="{Binding Id}" Click="Resolve_Click" VerticalAlignment="Top" svc:Access.Permission="reminders"/>
                            <StackPanel>
                                <TextBlock Text="{Binding ReminderType}" FontSize="11" Foreground="#667888" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#2A3A48" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding Severity}" Foreground="#9A5B12" FontSize="12" Margin="0,8,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>

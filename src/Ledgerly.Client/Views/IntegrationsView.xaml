<UserControl x:Class="Ledgerly.Client.Views.IntegrationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Backup now" Style="{StaticResource PrimaryButton}" Click="Backup_Click" Margin="0,0,8,0"/>
            <Button Content="Shopify sync (stub)" Style="{StaticResource SecondaryButton}" Click="Shopify_Click" Margin="0,0,8,0"/>
            <Button Content="Accounting export" Style="{StaticResource SecondaryButton}" Click="Export_Click" Margin="0,0,8,0"/>
            <Button Content="Create API key" Style="{StaticResource SecondaryButton}" Click="ApiKey_Click" Margin="0,0,8,0"/>
            <Button Content="Add webhook" Style="{StaticResource SecondaryButton}" Click="Webhook_Click"/>
        </StackPanel>
        <TabControl BorderThickness="0">
            <TabItem Header="Integration log">
                <DataGrid x:Name="LogGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0"
                          HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When" Binding="{Binding CreatedAt}" Width="140"/>
                        <DataGridTextColumn Header="System" Binding="{Binding SystemName}" Width="100"/>
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="120"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Webhooks">
                <DataGrid x:Name="HookGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0"
                          HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Event" Binding="{Binding EventName}" Width="160"/>
                        <DataGridTextColumn Header="URL" Binding="{Binding TargetUrl}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Backups">
                <DataGrid x:Name="BackupGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0"
                          HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="160"/>
                        <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="100"/>
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Audit">
                <DataGrid x:Name="AuditGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0"
                          HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When" Binding="{Binding CreatedAt}" Width="140"/>
                        <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="100"/>
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="100"/>
                        <DataGridTextColumn Header="Entity" Binding="{Binding EntityType}" Width="120"/>
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>

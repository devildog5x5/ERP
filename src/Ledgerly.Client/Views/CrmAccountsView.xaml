<UserControl x:Class="Ledgerly.Client.Views.CrmAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Ledgerly.Client.Services">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Add account" Style="{StaticResource PrimaryButton}" Click="Add_Click" Margin="0,0,8,0" svc:Access.Permission="crm"/>
            <Button Content="Edit" Style="{StaticResource SecondaryButton}" Click="Edit_Click" Margin="0,0,8,0" svc:Access.Permission="crm"/>
            <Button Content="Link / create ERP customer" Style="{StaticResource SecondaryButton}" Click="Link_Click" Margin="0,0,8,0" svc:Access.Permission="crm"/>
            <Button Content="Delete" Style="{StaticResource DangerButton}" Click="Delete_Click" svc:Access.Permission="crm"/>
        </StackPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  BorderThickness="0" CanUserAddRows="False" RowHeight="38" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Account" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Industry" Binding="{Binding Industry}" Width="140"/>
                <DataGridTextColumn Header="Website" Binding="{Binding Website}" Width="160"/>
                <DataGridTextColumn Header="Billing email" Binding="{Binding BillingEmail}" Width="180"/>
                <DataGridTextColumn Header="ERP customer" Binding="{Binding CustomerName}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

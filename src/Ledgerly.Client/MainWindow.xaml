<Window x:Class="Ledgerly.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ledgerly ERP"
        Height="780" Width="1280"
        MinHeight="640" MinWidth="980"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="4,8,4,24">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource BrandBrush}" Margin="0,0,12,0">
                            <TextBlock Text="L" Foreground="White" FontSize="20" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Ledgerly" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Operations ERP" Foreground="#9AA8B4" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="#14FFFFFF" CornerRadius="12" Padding="12" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock x:Name="UserStatus" Text="Signed in" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock x:Name="ConnectionStatus" Text="Connecting…" TextWrapping="Wrap"
                                   Foreground="#9AA8B4" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <TextBlock Text="OVERVIEW" Foreground="#6A7A88" FontSize="11" FontWeight="Bold" Margin="12,0,0,6"/>
                    <Button Content="Dashboard" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="dashboard"/>
                    <Button Content="Scan station" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="scan"/>
                    <Button Content="Reports" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="reports"/>
                    <Button Content="Reminders" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="reminders"/>

                    <TextBlock Text="OPERATIONS" Foreground="#6A7A88" FontSize="11" FontWeight="Bold" Margin="12,16,0,6"/>
                    <Button Content="Inventory" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="inventory"/>
                    <Button Content="Warehouse" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="warehouse"/>
                    <Button Content="Purchasing" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="purchasing"/>
                    <Button Content="Sales" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="sales"/>

                    <TextBlock Text="DIRECTORY" Foreground="#6A7A88" FontSize="11" FontWeight="Bold" Margin="12,16,0,6"/>
                    <Button Content="Suppliers" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="suppliers"/>
                    <Button Content="Customers" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="customers"/>

                    <TextBlock Text="FINANCE" Foreground="#6A7A88" FontSize="11" FontWeight="Bold" Margin="12,16,0,6"/>
                    <Button Content="Finance / GL" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="finance"/>

                    <TextBlock Text="SYSTEM" Foreground="#6A7A88" FontSize="11" FontWeight="Bold" Margin="12,16,0,6"/>
                    <Button Content="Users" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="users"/>
                    <Button Content="Integrations" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="integrations"/>
                    <Button Content="Settings" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="settings"/>
                    </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1" Margin="28,24,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="EyebrowText" Text="OVERVIEW" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="TitleText" Text="Operations dashboard" FontSize="30" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" Margin="0,4,0,0"/>
                    <TextBlock x:Name="SubtitleText" Text="Monitor stock health, open buying, and critical reminders."
                               Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button x:Name="SecondaryAction" Content="Run reminder scan" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0" Click="SecondaryAction_Click"/>
                    <Button x:Name="PrimaryAction" Content="Refresh" Style="{StaticResource PrimaryButton}"
                            Click="PrimaryAction_Click"/>
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="14"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18">
                <ContentControl x:Name="ContentHost"/>
            </Border>
        </Grid>
    </Grid>
</Window>

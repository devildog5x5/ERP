<Window x:Class="Ledgerly.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Ledgerly.Client.Services"
        Title="Coalesce"
        Icon="pack://application:,,,/Assets/coalesce.ico"
        Height="780" Width="1280"
        MinHeight="640" MinWidth="980"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="4,8,4,24">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="10" Background="White" Margin="0,0,12,0"
                                BorderBrush="#2A3540" BorderThickness="1" ClipToBounds="True">
                            <Image Source="pack://application:,,,/Assets/coalesce-icon.png" Stretch="Uniform"
                                   Margin="3" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Coalesce" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Where ERP and CRM come together" Foreground="#9AA8B4" FontSize="11"
                                       TextWrapping="Wrap" MaxWidth="160"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="#14FFFFFF" CornerRadius="12" Padding="12" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock x:Name="UserStatus" Text="Signed in" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock x:Name="ConnectionStatus" Text="Connecting…" TextWrapping="Wrap"
                                   Foreground="#9AA8B4" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Fill child of DockPanel must be ScrollViewer (not a StackPanel) or nav items get clipped with no scrollbar. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              VerticalAlignment="Stretch" Margin="0,0,0,0">
                    <StackPanel x:Name="NavPanel">
                        <TextBlock x:Name="NavOverviewHeader" Text="OVERVIEW" Foreground="#6A7A88" FontSize="11" FontWeight="Bold" Margin="12,0,0,6"/>
                        <Button Content="Dashboard" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="dashboard" svc:Access.Permission="dashboard"/>
                        <Button Content="Scan station" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="scan" svc:Access.Permission="scan"/>
                        <Button Content="Reports" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="reports" svc:Access.Permission="reports"/>
                        <Button Content="Reminders" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="reminders" svc:Access.Permission="reminders"/>

                        <TextBlock x:Name="NavOperationsHeader" Text="OPERATIONS" Foreground="#6A7A88" FontSize="11" FontWeight="Bold" Margin="12,16,0,6"/>
                        <Button Content="Inventory" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="inventory" svc:Access.Permission="inventory"/>
                        <Button Content="Warehouse" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="warehouse" svc:Access.Permission="warehouse"/>
                        <Button Content="Purchasing" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="purchasing" svc:Access.Permission="purchasing"/>
                        <Button Content="Sales" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="sales" svc:Access.Permission="sales"/>

                        <TextBlock x:Name="NavDirectoryHeader" Text="DIRECTORY" Foreground="#6A7A88" FontSize="11" FontWeight="Bold" Margin="12,16,0,6"/>
                        <Button Content="Suppliers" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="suppliers" svc:Access.Permission="partners"/>
                        <Button Content="Customers" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="customers" svc:Access.Permission="partners"/>

                        <TextBlock x:Name="NavCrmHeader" Text="CRM" Foreground="#6A7A88" FontSize="11" FontWeight="Bold" Margin="12,16,0,6"/>
                        <Button Content="Pipeline" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="crm-pipeline" svc:Access.Permission="crm"/>
                        <Button Content="Leads" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="crm-leads" svc:Access.Permission="crm"/>
                        <Button Content="Accounts" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="crm-accounts" svc:Access.Permission="crm"/>
                        <Button Content="Contacts" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="crm-contacts" svc:Access.Permission="crm"/>
                        <Button Content="Activities" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="crm-activities" svc:Access.Permission="crm"/>

                        <TextBlock x:Name="NavFinanceHeader" Text="FINANCE" Foreground="#6A7A88" FontSize="11" FontWeight="Bold" Margin="12,16,0,6"/>
                        <Button Content="Finance / GL" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="finance" svc:Access.Permission="finance"/>

                        <TextBlock x:Name="NavSecurityHeader" Text="SECURITY" Foreground="#6A7A88" FontSize="11" FontWeight="Bold" Margin="12,16,0,6"/>
                        <Button x:Name="NavUsersBtn" Content="Users &amp; access" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="users"/>
                        <Button x:Name="NavPasswordBtn" Content="Change password" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="password"/>

                        <TextBlock x:Name="NavSystemHeader" Text="SYSTEM" Foreground="#6A7A88" FontSize="11" FontWeight="Bold" Margin="12,16,0,6"/>
                        <Button Content="Integrations" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="integrations" svc:Access.Permission="integrations"/>
                        <Button Content="Settings" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="settings" svc:Access.Permission="settings"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1" Margin="28,24,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="EyebrowText" Text="OVERVIEW" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="TitleText" Text="Operations dashboard" FontSize="30" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" Margin="0,4,0,0"/>
                    <TextBlock x:Name="SubtitleText" Text="Monitor stock health, open buying, and critical reminders."
                               Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button x:Name="SecondaryAction" Content="Run reminder scan" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0" Click="SecondaryAction_Click" svc:Access.Permission="reminders"/>
                    <Button x:Name="PrimaryAction" Content="Refresh" Style="{StaticResource PrimaryButton}"
                            Click="PrimaryAction_Click"/>
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="14"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18">
                <ContentControl x:Name="ContentHost"/>
            </Border>
        </Grid>
    </Grid>
</Window>
